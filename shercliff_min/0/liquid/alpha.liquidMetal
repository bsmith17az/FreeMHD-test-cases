FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/liquid";
    object      alpha.liquidMetal;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 0 0 0 0 ];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }
    sink
    {
        type            zeroGradient;
        value           uniform 0;
    }
    liquid_to_solidWalls
    {
        type            zeroGradient;
        value           uniform 0;
    }
    liquid_to_insulator
    {
        type            zeroGradient;
        value           uniform 0;
    }
}


// ************************************************************************* //
